{
"version": 2,
"rewrites": [
{
"source": "/api/events",
"destination": "/api/events.js"
},
{
"source": "/api/regions",
"destination": "/api/regions.js"
}
],
"headers": [
{
"source": "/api/(.*)",
"headers": [
{
"key": "Cache-Control",
"value": "public, s-maxage=60, stale-while-revalidate=300"
}
]
}
]
}
